<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMERGENCY SOS"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/sos_red"
        android:layout_marginBottom="32dp" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:padding="16dp"
        android:text="Press and hold for emergency"
        android:textAlignment="center"
        android:textSize="18sp" />

    <!-- Countdown Text -->
    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 seconds"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/sos_red"
        android:layout_marginBottom="32dp"
        android:visibility="gone" />

    <!-- SOS Button -->
    <Button
        android:id="@+id/btn_sos"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:text="SOS"
        android:textSize="36sp"
        android:backgroundTint="@color/sos_red"
        android:textColor="@android:color/white"
        android:layout_marginBottom="32dp"
        android:stateListAnimator="@null"
        android:elevation="8dp" />

    <!-- Instructions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠ Hold for 5 seconds to activate\nWill call emergency contact and send location"
        android:textSize="14sp"
        android:textAlignment="center"
        android:textColor="#757575"
        android:lineSpacingExtra="4sp" />

</LinearLayout>